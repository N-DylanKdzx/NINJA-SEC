          "Ref": "DbRoutesB"
        }
      }
    },
    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "NINJA-SEC AlbSecurityGroup",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "127.0.0.1/32",
            "Description": "Explicit placeholder prevents default allow-all; replace with required egress before compute"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "ninjasec-albsecuritygroup"
          },
          {
            "Key": "Project",
            "Value": "NINJA-SEC"
          }
        ]
      }
    },
    "AppSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "NINJA-SEC AppSecurityGroup",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "127.0.0.1/32",
            "Description": "Explicit placeholder prevents default allow-all; replace with required egress before compute"
          }
