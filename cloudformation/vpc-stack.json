          },
          {
            "Key": "Project",
            "Value": "NINJA-SEC"
          }
        ]
      }
    },
    "AppRoutesA": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "ninjasec-approutesa"
          },
          {
            "Key": "Project",
            "Value": "NINJA-SEC"
          }
        ]
      }
    },
    "AppRoutesB": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "ninjasec-approutesb"
          },
          {
            "Key": "Project",
            "Value": "NINJA-SEC"
          }
        ]
      }
    },
    "DbRoutesA": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "ninjasec-dbroutesa"
          },
          {
            "Key": "Project",
            "Value": "NINJA-SEC"
          }
        ]
      }
    },
    "DbRoutesB": {
      "Type": "AWS::EC2::RouteTable",
