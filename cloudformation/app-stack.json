{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NINJA-SEC private app launch template with Ubuntu Nginx ModSecurity CRS and portal package; real API requires provisioned credentials. No ASG or running nodes in this stack.",
  "Resources": {
    "AppLaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateName": "ninjasec-app-private",
        "LaunchTemplateData": {
          "ImageId": "ami-08b275ac6cc5dbefb",
          "InstanceType": "t3.micro",
          "IamInstanceProfile": {
            "Name": "LabInstanceProfile"
          },
          "SecurityGroupIds": [
            "sg-0e248bc79d72b4c69"
          ],
          "CreditSpecification": {
            "CpuCredits": "standard"
          },
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpEndpoint": "enabled",
            "HttpPutResponseHopLimit": 1
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "Encrypted": true,
                "VolumeType": "gp3",
                "VolumeSize": 8,
                "DeleteOnTermination": true
              }
            }
          ],
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "NINJA-SEC"
                },
                {
                  "Key": "Name",
                  "Value": "ninjasec-app"
                }
              ]
            },
            {
              "ResourceType": "volume",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "NINJA-SEC"
                }
              ]
            }
          ],
          "UserData": ""
        }
      }
    },
    "WafLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ninjasec/waf/blocked",
        "RetentionInDays": 7
      }
    },
    "NginxLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ninjasec/nginx/access",
        "RetentionInDays": 7
      }
    },
    "AppLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ninjasec/app",
        "RetentionInDays": 7
      }
    },
    "WafMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "WafLogs"
        },
        "FilterPattern": "\"ModSecurity: Access denied\"",
        "MetricTransformations": [
          {
            "MetricNamespace": "NINJA-SEC/Security",
            "MetricName": "WafBlockedRequests",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "WafAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ninjasec-waf-blocked",
        "AlarmDescription": "At least one real ModSecurity block in five minutes. Notification subscription pending A13.5.",
        "Namespace": "NINJA-SEC/Security",
        "MetricName": "WafBlockedRequests",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "LaunchTemplateId": {
      "Value": {
        "Ref": "AppLaunchTemplate"
      }
    }
  }
}
