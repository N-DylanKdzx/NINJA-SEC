{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "WireGuard perimeter on the existing router. OCI initiates through its existing NAT. Does not activate cross-cloud subnet routes.",
  "Parameters": {
    "RouterSecurityGroup": {"Type": "AWS::EC2::SecurityGroup::Id"},
    "EdgeNetworkAcl": {"Type": "String"},
    "OciNatCidr": {"Type": "String", "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32"}
  },
  "Resources": {
    "WireGuardIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {"Ref": "RouterSecurityGroup"},
        "IpProtocol": "udp", "FromPort": 51820, "ToPort": 51820,
        "CidrIp": {"Ref": "OciNatCidr"},
        "Description": "Only existing OCI NAT may initiate WireGuard"
      }
    },
    "WireGuardEdgeIngress": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {"Ref": "EdgeNetworkAcl"}, "RuleNumber": 140,
        "Protocol": 17, "RuleAction": "allow", "Egress": false,
        "CidrBlock": {"Ref": "OciNatCidr"},
        "PortRange": {"From": 51820, "To": 51820}
      }
    }
  }
}
