{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AWS routes and private MySQL network rules for a new OCI WireGuard deployment. Supply outputs from the network, router and OCI deployments.",
  "Resources": {
    "AppAOciRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRouteTableA"
        },
        "DestinationCidrBlock": {
          "Ref": "OciNetworkCidr"
        },
        "InstanceId": {
          "Ref": "WireGuardRouterInstance"
        }
      }
    },
    "AppBOciRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRouteTableB"
        },
        "DestinationCidrBlock": {
          "Ref": "OciNetworkCidr"
        },
        "InstanceId": {
          "Ref": "WireGuardRouterInstance"
        }
      }
    },
    "DbAOciRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "DbRouteTableA"
        },
        "DestinationCidrBlock": {
          "Ref": "OciNetworkCidr"
        },
        "InstanceId": {
          "Ref": "WireGuardRouterInstance"
        }
      }
    },
    "DbBOciRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "DbRouteTableB"
        },
        "DestinationCidrBlock": {
          "Ref": "OciNetworkCidr"
        },
        "InstanceId": {
          "Ref": "WireGuardRouterInstance"
        }
      }
    },
    "RouterFromAppA": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "RouterSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "AppSubnetCidrA"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "RouterFromAppB": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "RouterSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "AppSubnetCidrB"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "RouterFromHeatwave": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "RouterSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "HeatWaveHostCidr"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "RouterToHeatwave": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "RouterSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "HeatWaveHostCidr"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "AppToHeatwave": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "AppSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "HeatWaveHostCidr"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "DbFromHeatwave": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DbSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "HeatWaveHostCidr"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "RouterToDbA": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "RouterSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "DbSubnetCidrA"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "RouterToDbB": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "RouterSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "CidrIp": {
          "Ref": "DbSubnetCidrB"
        },
        "Description": "NINJA-SEC private MySQL over WireGuard; TLS required by database"
      }
    },
    "AppToHeatwaveAcl": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "AppNetworkAcl"
        },
        "RuleNumber": 140,
        "Protocol": 6,
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Ref": "HeatWaveHostCidr"
        },
        "PortRange": {
          "From": 3306,
          "To": 3306
        }
      }
    },
    "DbFromHeatwaveAcl": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "DbNetworkAcl"
        },
        "RuleNumber": 120,
        "Protocol": 6,
        "RuleAction": "allow",
        "Egress": false,
        "CidrBlock": {
          "Ref": "HeatWaveHostCidr"
        },
        "PortRange": {
          "From": 3306,
          "To": 3306
        }
      }
    },
    "DbReturnHeatwaveAcl": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "DbNetworkAcl"
        },
        "RuleNumber": 110,
        "Protocol": 6,
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Ref": "HeatWaveHostCidr"
        },
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    }
  },
  "Parameters": {
    "AppRouteTableA": {
      "Type": "String",
      "AllowedPattern": "rtb-[a-f0-9]+"
    },
    "AppRouteTableB": {
      "Type": "String",
      "AllowedPattern": "rtb-[a-f0-9]+"
    },
    "DbRouteTableA": {
      "Type": "String",
      "AllowedPattern": "rtb-[a-f0-9]+"
    },
    "DbRouteTableB": {
      "Type": "String",
      "AllowedPattern": "rtb-[a-f0-9]+"
    },
    "WireGuardRouterInstance": {
      "Type": "String",
      "AllowedPattern": "i-[a-f0-9]+"
    },
    "RouterSecurityGroup": {
      "Type": "String",
      "AllowedPattern": "sg-[a-f0-9]+"
    },
    "AppSecurityGroup": {
      "Type": "String",
      "AllowedPattern": "sg-[a-f0-9]+"
    },
    "DbSecurityGroup": {
      "Type": "String",
      "AllowedPattern": "sg-[a-f0-9]+"
    },
    "AppNetworkAcl": {
      "Type": "String",
      "AllowedPattern": "acl-[a-f0-9]+"
    },
    "DbNetworkAcl": {
      "Type": "String",
      "AllowedPattern": "acl-[a-f0-9]+"
    },
    "AppSubnetCidrA": {
      "Type": "String",
      "AllowedPattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])"
    },
    "AppSubnetCidrB": {
      "Type": "String",
      "AllowedPattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])"
    },
    "DbSubnetCidrA": {
      "Type": "String",
      "AllowedPattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])"
    },
    "DbSubnetCidrB": {
      "Type": "String",
      "AllowedPattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])"
    },
    "OciNetworkCidr": {
      "Type": "String",
      "AllowedPattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])"
    },
    "HeatWaveHostCidr": {
      "Type": "String",
      "AllowedPattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32"
    }
  }
}
